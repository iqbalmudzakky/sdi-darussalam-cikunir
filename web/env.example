# Alamat publik situs. Dipakai untuk metadata, sitemap, tautan di email, dan
# alamat callback/notifikasi DOKU di produksi. Saat development nilainya
# diabaikan untuk DOKU: host diambil dari request, sehingga tunnel bekerja
# apa adanya.
#
# Sengaja BUKAN NEXT_PUBLIC_: variabel NEXT_PUBLIC_ ditanam saat build, dan itu
# membuat satu image tidak bisa dipakai untuk staging sekaligus production.
SITE_URL=https://www.sdidarussalamcikunir.sch.id

# PostgreSQL. Di server, aplikasi berada satu jaringan Docker dengan database:
#   postgres://pmb_production:<sandi>@postgres:5432/pmb_production
# Dari laptop, lewat SSH tunnel ke VPS:
#   postgres://pmb_staging:<sandi>@127.0.0.1:5432/pmb_staging
DATABASE_URL=your_database_url_here

# Folder tempat foto yang diunggah disimpan. Di server ini adalah volume
# (/var/lib/pmb/<env>/uploads) yang juga dibaca Caddy untuk melayani /uploads/*;
# di laptop cukup folder mana saja DI LUAR repo. Nilainya tidak boleh berubah
# setelah ada isinya — jalur di database menunjuk ke berkas di dalamnya.
UPLOAD_DIR=C:/Dzakky/works/PID//uploads-pmb

JWT_ACCESS_SECRET=your_random_secret_here
JWT_REFRESH_PEPPER=your_random_secret_here

RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=no-reply@sdidarussalamcikunir.sch.id

CRON_SECRET=your_random_secret_here

# Garam untuk sidik pengunjung di tabel site_visits. IP tidak pernah disimpan;
# yang dicatat hanya sha256(IP + user agent + garam ini + tanggal). Tanpa garam
# ini pencatatan kunjungan ditolak, karena hash tanpa garam bisa dibalik dengan
# mencoba seluruh alamat IPv4. Jangan diganti tanpa alasan: menggantinya
# membuat pengunjung lama terhitung sebagai orang baru.
ANALYTICS_SALT=your_random_secret_here

# DOKU Checkout (non-SNAP)
# DOKU_ENV: "sandbox" (default) atau "production"
DOKU_ENV=sandbox
DOKU_CLIENT_ID=your_doku_brand_id_here
DOKU_SECRET_KEY=your_doku_secret_key_here
# Biaya pendaftaran tidak diatur di sini — nilainya ada di tabel payment_settings
# dan disunting dari dashboard admin (Administrasi > Pembayaran), sehingga
# mengubahnya tidak menuntut deploy ulang.
