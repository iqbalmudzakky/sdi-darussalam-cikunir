VERCEL_OIDC_TOKEN=your_token_here

NEXT_PUBLIC_SITE_URL=https://www.sdidarussalamcikunir.sch.id/
NEXT_PUBLIC_SUPABASE_URL="https://huvfvfxxjoecpbkjdcli.supabase.co"

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=your_database_url_here

JWT_ACCESS_SECRET=your_random_secret_here
JWT_REFRESH_PEPPER=your_random_secret_here

RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=no-reply@sdidarussalamcikunir.sch.id

CRON_SECRET=your_random_secret_here

# Garam untuk sidik pengunjung di tabel site_visits. IP tidak pernah disimpan;
# yang dicatat hanya sha256(IP + user agent + garam ini + tanggal). Tanpa garam
# ini pencatatan kunjungan ditolak, karena hash tanpa garam bisa dibalik dengan
# mencoba seluruh alamat IPv4. Jangan diganti tanpa alasan: menggantinya
# membuat pengunjung lama terhitung sebagai orang baru.
ANALYTICS_SALT=your_random_secret_here

# DOKU Checkout (non-SNAP)
# DOKU_ENV: "sandbox" (default) or "production"
DOKU_ENV=sandbox
DOKU_CLIENT_ID=your_doku_brand_id_here
DOKU_SECRET_KEY=your_doku_secret_key_here
# The registration fee is no longer set here — it lives in the payment_settings
# table and is edited from the admin dashboard (Administrasi > Pembayaran), so
# changing it does not need a redeploy.

# NEXT_PUBLIC_SITE_URL is the public base URL for DOKU callback + notification
# URLs in production. In development it is ignored: the host is taken from the
# incoming request instead, so a tunnel (cloudflared/ngrok) works as-is.
