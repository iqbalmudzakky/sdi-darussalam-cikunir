NEXT_PUBLIC_SUPABASE_URL="https://huvfvfxxjoecpbkjdcli.supabase.co"

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=your_database_url_here

JWT_ACCESS_SECRET=your_random_secret_here
JWT_REFRESH_PEPPER=your_random_secret_here

RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=no-reply@sdidarussalamcikunir.sch.id

CRON_SECRET=your_random_secret_here
# DOKU Checkout (non-SNAP)
# DOKU_ENV: "sandbox" (default) or "production"
DOKU_ENV=sandbox
DOKU_CLIENT_ID=your_doku_brand_id_here
DOKU_SECRET_KEY=your_doku_secret_key_here
# Amount charged to the applicant, in IDR, integer, no decimals.
#
# This is the school's fee plus a margin covering DOKU's MDR, which is deducted
# from the amount received rather than added on top. Checkout fixes the amount
# before the applicant picks a method, so a single figure has to cover the
# most expensive one:
#   VA BCA        Rp4.500 + 11% PPN = Rp4.995   <- worst case
#   VA other/QRIS Rp4.000 + 11% PPN = Rp4.440
#   e-wallet      2% + 11% PPN      = 2.22%
# At 155000 the school nets at least Rp150.005 on every method.
# Revisit this if DOKU changes its rates or the fee itself changes.
DOKU_REGISTRATION_FEE=155000
# NEXT_PUBLIC_SITE_URL is the public base URL for DOKU callback + notification
# URLs in production. In development it is ignored: the host is taken from the
# incoming request instead, so a tunnel (cloudflared/ngrok) works as-is.
