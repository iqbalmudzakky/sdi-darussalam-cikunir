VERCEL_OIDC_TOKEN=your_token_here

# Optional. Set this once a custom domain is bought — used for SEO metadata
# (Open Graph, canonical URL, etc). Without it, falls back to the Vercel
# production/preview URL automatically, then localhost in local dev.
NEXT_PUBLIC_SITE_URL=your_custom_domain_here

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

DATABASE_URL=your_database_url_here